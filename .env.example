# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Chat ID kamu (WAJIB — bot cuma jawab chat ini; bisa beberapa, pisah koma).
# Cara dapat: chat @userinfobot di Telegram.
TELEGRAM_CHAT_ID=123456789

# Private key hot wallet (tanpa/dengan 0x sama saja)
PRIVATE_KEY=0xyourprivatekeyhex

# Opsional: wallet tambahan (W2, W3, ... — ganti wallet aktif lewat tombol di /start)
# PRIVATE_KEY_2=0x...
# PRIVATE_KEY_3=0x...

# Opsional: override RPC default
# RPC_4663=https://rpc.mainnet.chain.robinhood.com
# RPC_56=https://1rpc.io/bnb
# RPC_8453=https://mainnet.base.org
# RPC_999=https://rpc.hyperliquid.xyz/evm
# RPC_5042=https://rpc.mainnet.arc.io

# Opsional tapi disarankan: API key Alchemy (https://dashboard.alchemy.com)
# Kalau diisi, bot pakai RPC Alchemy sebagai prioritas (robinhood-mainnet, bnb-mainnet,
# base-mainnet, hyperliquid-mainnet, arc-mainnet — stabil, tidak kena blokir DNS ISP).
# Tiap network harus di-ENABLE per app di dashboard Alchemy; kalau tidak, jawabannya
# 403 dan bot diam-diam jatuh ke RPC publik yang jauh lebih lambat. Cek dengan /rpc all.
# ALCHEMY_API_KEY=your-key
#
# Beberapa key sekaligus: kuota Alchemy dihitung PER APP, jadi tiap key menambah
# jatah. Bot memperlakukan tiap key sebagai endpoint tersendiri — begitu satu kena
# 429 ia ditandai dan panggilan berikutnya lewat key lain (rotasi 120 detik).
# ALCHEMY_API_KEYS=key1,key2,key3
# ALCHEMY_API_KEY_2=key-cadangan
#
# Alternatif yang lebih enak dikelola: satu key per baris di `alchemy_keys.txt`
# (contoh: alchemy_keys.txt.example, sudah di .gitignore). Digabung dengan yang
# di sini, bukan menggantikan. Pindah lokasi: ALCHEMY_KEY_FILE=/path/file.txt

# Opsional: proxy untuk API DATA PASAR saja (Krystal / indexer Uniswap /
# dexscreener / GeckoTerminal). TIDAK dipakai untuk RPC — angka dari API itu
# memang cuma tampilan dan tiap pool tetap diverifikasi on-chain, sedangkan
# menyalurkan RPC lewat pihak ketiga akan membuang jaminan itu.
#
# Perlu kalau server kamu kena Cloudflare "Just a moment…" (lazim di IP
# datacenter). Format per entri: ip:port:user:pass, atau URL penuh
# (http://user:pass@ip:port). Pisahkan dengan koma / baris baru.
# Jalur langsung dicoba DULU; proxy hanya dipakai kalau jawabannya 4xx/5xx.
# PROXY_LIST=1.2.3.4:8000:user:pass,5.6.7.8:8000:user:pass

# Opsional — jembatan alert token trending (lp-scanner / GMGN).
# Isi dengan path file JSONL yang SAMA dengan LP_ALERT_INBOX di scanner itu.
# Bot memantaunya tiap 10 detik, mencari pool, lalu mengirim kartu bertombol.
# MINT TETAP MANUAL — jalur ini tidak pernah mengirim transaksi.
LP_ALERT_INBOX=

# Opsional — scanner token trending bawaan (GMGN OpenAPI).
# Key gratis di https://gmgn.ai/ai. Tanpa ini scanner tidak jalan; sisa bot normal.
# Nyalakan lewat /scanner di Telegram.
GMGN_API_KEY=

# ── Solana (Meteora DLMM) ─────────────────────────────────────────────────
# Private key WALLET SOLANA. WAJIB terpisah dari PRIVATE_KEY di atas: key EVM
# itu secp256k1 dan Solana ed25519 — dipakai silang bukan cuma gagal, ia
# menghasilkan alamat yang bukan milik siapa pun.
# Format: base58 (ekspor Phantom/Solflare) ATAU array JSON 64 byte
# (`solana-keygen`, mis. [12,34,...]). Beberapa wallet: SOLANA_PRIVATE_KEYS,
# dipisah koma/spasi/baris.
SOLANA_PRIVATE_KEY=

# Opsional — priority fee Solana, micro-lamport per compute unit. 0 = tanpa
# priority fee. Saat jaringan ramai, tx DLMM tanpa priority fee tertinggal dan
# yang terlihat cuma "timeout".
# SOLANA_PRIORITY_FEE=0

# Opsional — RPC Solana tambahan/pengganti (dipisah koma/spasi). Kalau kosong,
# dipakai key Alchemy yang sudah ada (network SOLANA_MAINNET harus di-enable
# per app di dashboard Alchemy, sama seperti base-mainnet dan arc-mainnet).
# RPC_SOLANA=https://...
