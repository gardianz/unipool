# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Chat ID kamu (WAJIB — bot cuma jawab chat ini; bisa beberapa, pisah koma).
# Cara dapat: chat @userinfobot di Telegram.
TELEGRAM_CHAT_ID=123456789

# Private key hot wallet (tanpa/dengan 0x sama saja)
PRIVATE_KEY=0xyourprivatekeyhex

# Opsional: wallet tambahan (W2, W3, ... — ganti wallet aktif lewat tombol di /start)
# PRIVATE_KEY_2=0x...
# PRIVATE_KEY_3=0x...

# Opsional: override RPC default
# RPC_4663=https://rpc.mainnet.chain.robinhood.com
# RPC_56=https://1rpc.io/bnb

# Opsional tapi disarankan: API key Alchemy (https://dashboard.alchemy.com)
# Kalau diisi, bot pakai RPC Alchemy sebagai prioritas (robinhood-mainnet + bnb-mainnet,
# stabil, tidak kena blokir DNS ISP)
# ALCHEMY_API_KEY=your-key

# Opsional: proxy untuk API DATA PASAR saja (Krystal / indexer Uniswap /
# dexscreener / GeckoTerminal). TIDAK dipakai untuk RPC — angka dari API itu
# memang cuma tampilan dan tiap pool tetap diverifikasi on-chain, sedangkan
# menyalurkan RPC lewat pihak ketiga akan membuang jaminan itu.
#
# Perlu kalau server kamu kena Cloudflare "Just a moment…" (lazim di IP
# datacenter). Format per entri: ip:port:user:pass, atau URL penuh
# (http://user:pass@ip:port). Pisahkan dengan koma / baris baru.
# Jalur langsung dicoba DULU; proxy hanya dipakai kalau jawabannya 4xx/5xx.
# PROXY_LIST=1.2.3.4:8000:user:pass,5.6.7.8:8000:user:pass
